{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npx opennextjs-cloudflare"
  },
  "observability": {
    "enabled": true
  }
}
