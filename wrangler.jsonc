{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "GOOGLE_SHEETS_API_URL": "https://script.google.com/macros/s/AKfycby5hikFkv1__CQlkwSLoAFhnHM3SGesvHI84uIl9hlExn-6WX7WPVRe0nOD_kjbeoQOtw/exec",
    "NEXT_PUBLIC_CATALOG_API_URL": "https://script.google.com/macros/s/AKfycby5hikFkv1__CQlkwSLoAFhnHM3SGesvHI84uIl9hlExn-6WX7WPVRe0nOD_kjbeoQOtw/exec"
  },
  "build": {
    "command": "npm install && npx opennextjs-cloudflare"
  },
  "observability": {
    "enabled": true
  }
}

